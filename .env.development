# Local development — requests go through Vite proxy to https://localhost:7118
# Leave this empty so the proxy in vite.config.ts handles it
VITE_API_BASE_URL=

# Binance WebSocket base URL for real-time market data streams
# Futures: wss://fstream.binance.com | Spot: wss://stream.binance.com:9443
VITE_BINANCE_WS_URL=wss://fstream.binance.com

# Comma-separated symbols to stream (lowercase, Binance format)
VITE_BINANCE_STREAM_SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt,nearusdt
