# Production — point to your deployed backend API
# Replace with your actual backend URL (e.g. Azure, Railway, Render, etc.)
VITE_API_BASE_URL=https://crypto-evaluator-api.onrender.com

# Binance WebSocket base URL for real-time market data streams
# Futures: wss://fstream.binance.com | Spot: wss://stream.binance.com:9443
VITE_BINANCE_WS_URL=wss://fstream.binance.com

# Comma-separated symbols to stream (lowercase, Binance format)
VITE_BINANCE_STREAM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,NEARUSDT,ADAUSDT,AVAXUSDT,DOGEUSDT,LINKUSDT,SUIUSDT,PEPEUSDT
